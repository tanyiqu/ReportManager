{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReportManager",
  "version": "0.1.0",
  "identifier": "com.tanyiqu.report-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReportManager - 个人工作记录",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
